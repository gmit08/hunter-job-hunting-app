# Password for the dashboard. Leave this blank only on your own computer.
# If it is blank, anyone with the link can open the page.
DASHBOARD_PASSWORD=

# Paste the entire service-account JSON key file as one value.
# Leave every Google variable blank to see sample applications.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Or, instead of the JSON file, set both of these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Required once Google credentials are set. There is no default spreadsheet.
# Paste the id from the sheet URL (the part between /d/ and /edit).
SPREADSHEET_ID=your-spreadsheet-id

# ZipRecruiter backlog routine. Both stay on the server and are never sent to the browser.
WEBHOOK_URL=
WEBHOOK_KEY=

# "Send all answers now" for ZipRecruiter rows, including a blank Source.
# The answer text is not included.
# Uses WEBHOOK_KEY_HEADER, WEBHOOK_KEY_SCHEME, and WEBHOOK_KEY_BODY_FIELD below.
ANSWERS_WEBHOOK_URL=
ANSWERS_WEBHOOK_KEY=

# "Send all answers now" for rows whose Source is LinkedIn.
# Leave both blank to skip that ping. The body is action "answers" and source "hunter".
# Uses the same WEBHOOK_KEY_HEADER, WEBHOOK_KEY_SCHEME, and WEBHOOK_KEY_BODY_FIELD.
LINKEDIN_ANSWERS_WEBHOOK_URL=
LINKEDIN_ANSWERS_WEBHOOK_KEY=

# "3-day check" pings this address. The body is action and source only.
# Uses the same WEBHOOK_KEY_HEADER, WEBHOOK_KEY_SCHEME, and WEBHOOK_KEY_BODY_FIELD.
THREEDAYCHECK_WEBHOOK_URL=
THREEDAYCHECK_WEBHOOK_KEY=

# Cell the assistant writes when a 3-day check finishes.
# Default is Dashboard Control!B2. A2 is the label. B1 is the pause switch.
# Value: an ISO-8601 UTC timestamp, for example 2026-10-28T02:19:00.000Z
THREEDAYCHECK_COMPLETED_CELL=Dashboard Control!B2

# Optional. Where the key is sent. See the README for examples.
# Default header is Authorization: Bearer <WEBHOOK_KEY>
WEBHOOK_KEY_HEADER=Authorization
WEBHOOK_KEY_SCHEME=Bearer
WEBHOOK_KEY_BODY_FIELD=
