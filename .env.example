# Password for the dashboard. Leave this blank only on your own computer.
# If it is blank, anyone with the link can open the page.
DASHBOARD_PASSWORD=

# Paste the entire service-account JSON key file as one value.
# Leave every Google variable blank to see sample applications.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Or, instead of the JSON file, set both of these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Required once Google credentials are set. There is no default spreadsheet.
# Paste the id from the sheet URL (the part between /d/ and /edit).
SPREADSHEET_ID=your-spreadsheet-id

# ZipRecruiter backlog routine. Both stay on the server and are never sent to the browser.
WEBHOOK_URL=
WEBHOOK_KEY=

# Optional. Where the key is sent. See the README for examples.
# Default header is Authorization: Bearer <WEBHOOK_KEY>
WEBHOOK_KEY_HEADER=Authorization
WEBHOOK_KEY_SCHEME=Bearer
WEBHOOK_KEY_BODY_FIELD=
